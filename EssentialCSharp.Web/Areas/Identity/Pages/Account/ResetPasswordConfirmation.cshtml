@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Reset password confirmation";
}

<h1>@ViewData["Title"]</h1>
<p>
    Your password has been reset. Please <a asp-page="./Login">click here to log in</a>.
</p>
<p>
    To keep your account safe, external logins (such as GitHub or Microsoft) and MCP tokens that were connected to
    this account have been removed. After you log in, you can link them again from your account settings.
</p>
