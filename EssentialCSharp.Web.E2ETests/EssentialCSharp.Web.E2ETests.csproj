<Project Sdk="Microsoft.NET.Sdk">

  <!--
    End-to-end tests against a running site. Tests in the "Deployed" category run only when
    E2E_BASE_URL is set (for example by the deploy-development job) and are skipped otherwise,
    so this project builds and runs harmlessly as part of the normal solution test run.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

</Project>
